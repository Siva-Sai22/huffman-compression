{
    "version": 4,
    "configurePresets": [
        {
            "name": "build",
            "displayName": "Build",
            "description": "Use this preset to generate a build system for the project.",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "binaryDir": "${sourceDir}/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build",
            "configurePreset": "build"
        },
        {
            "name": "debug",
            "configurePreset": "debug"
        }
    ]
}
